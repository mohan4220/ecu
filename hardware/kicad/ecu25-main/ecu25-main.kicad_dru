# interior nodes of the 4x330k sense chains (~85..255 Vpk)
(rule ac_chain_clearance
  (condition "A.NetName == 'Net-(R300-Pad2)' || A.NetName == 'Net-(R301-Pad2)' || A.NetName == 'Net-(R302-Pad2)' || A.NetName == 'Net-(R310-Pad2)' || A.NetName == 'Net-(R311-Pad2)' || A.NetName == 'Net-(R312-Pad2)' || A.NetName == 'Net-(R320-Pad2)' || A.NetName == 'Net-(R321-Pad2)' || A.NetName == 'Net-(R322-Pad2)' || A.NetName == 'Net-(R330-Pad2)' || A.NetName == 'Net-(R331-Pad2)' || A.NetName == 'Net-(R332-Pad2)' || A.NetName == 'Net-(R340-Pad2)' || A.NetName == 'Net-(R341-Pad2)' || A.NetName == 'Net-(R342-Pad2)' || A.NetName == 'Net-(R350-Pad2)' || A.NetName == 'Net-(R351-Pad2)' || A.NetName == 'Net-(R352-Pad2)'")
  (constraint clearance (min 1.0mm)))

# 415 V field wiring: GEN/MAINS phases (J5/J6) and volt-free contactor
# circuits (J15) — includes clearance to GND and to each other
(rule ac_line_clearance
  (condition "A.NetName == '/AC sensing/AC_GEN_L1' || A.NetName == '/AC sensing/AC_GEN_L2' || A.NetName == '/AC sensing/AC_GEN_L3' || A.NetName == '/AC sensing/AC_MAINS_L1' || A.NetName == '/AC sensing/AC_MAINS_L2' || A.NetName == '/AC sensing/AC_MAINS_L3' || A.NetName == '/Relay drivers/GEN_COM' || A.NetName == '/Relay drivers/GEN_NO' || A.NetName == '/Relay drivers/MAINS_COM' || A.NetName == '/Relay drivers/MAINS_NO'")
  (constraint clearance (min 3.0mm)))

# unwired pads (empty even poles of J5/J6/J15, mech pads): default clearance
(rule netless_pads
  (condition "A.NetName == ''")
  (constraint clearance (min 0.2mm)))

# a line net may sit 1.0mm from its OWN first divider node (same chain)
(rule ac_own_chain_1
