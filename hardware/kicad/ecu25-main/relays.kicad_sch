  (text "6x G5LE-1 24V relays, 2N7002K low-side drivers, SS34 flyback. GEN/MAINS contactor contacts are VOLT-FREE; panel wiring must also hardware-interlock the contactors."
    (at 20 18 0)
    (effects (font (size 2.0 2.0)) (justify left))
    (uuid c3454111-33a9-4d13-9860-f30c00518db7)
  )
  (text "J8: 1=FUEL 2=START 3=HORN 4=PREHEAT (switched +24V)"
    (at 14 30 0)
    (effects (font (size 1.5 1.5)) (justify left))
    (uuid da500196-53d4-45bd-9357-957bfa2679b7)
  )
  (text "J15: GEN COM/NO, MAINS COM/NO (volt-free contactor pairs)."
    (at 14 140 0)
    (effects (font (size 1.5 1.5)) (justify left))
    (uuid cb1255dd-d1a7-4635-9d6d-a82e9b513144)
  )
  (text "Separate block from J8: the two contactor coil circuits ride"
    (at 14 144 0)
    (effects (font (size 1.5 1.5)) (justify left))
    (uuid 2ab68514-e534-412b-8874-a7a3cd99e500)
  )
  (text "different AC sources; 8-pole body, odd poles wired (creepage)."
    (at 14 148 0)
    (effects (font (size 1.5 1.5)) (justify left))
    (uuid 776322ec-a759-463c-8fc1-8ff8bb78cc99)
  )
  (text "Note: FUEL relay = run-enable (K1). In J1939 mode it drives the engine-ECU enable input; in legacy mode the fuel solenoid."
    (at 20 290 0)
    (effects (font (size 1.5 1.5)) (justify left))
    (uuid 348f5a80-440a-40b8-b0c8-5d028c4b85a8)
  )

