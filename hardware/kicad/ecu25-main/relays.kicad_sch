  (text "6x G5LE-1 24V relays, 2N7002K low-side drivers, SS34 flyback. GEN/MAINS contactor contacts are VOLT-FREE; panel wiring must also hardware-interlock the contactors."
    (at 20 18 0)
    (effects (font (size 2.0 2.0)) (justify left))
    (uuid da7f3b0d-a92a-42a8-9340-dba1d95a3e4a)
  )
  (text "J8: 1=FUEL 2=START 3=HORN 4=PREHEAT (switched +24V)"
    (at 14 30 0)
    (effects (font (size 1.5 1.5)) (justify left))
    (uuid 9e1628b3-bf89-4f1a-8a6d-2c2b7b2ea696)
  )
  (text "    5/6=GEN contact pair  7/8=MAINS contact pair (volt-free)"
    (at 14 34 0)
    (effects (font (size 1.5 1.5)) (justify left))
    (uuid 504c5ae3-c220-4115-981c-d437dc658915)
  )
  (text "Note: FUEL relay = run-enable (K1). In J1939 mode it drives the engine-ECU enable input; in legacy mode the fuel solenoid."
    (at 20 290 0)
    (effects (font (size 1.5 1.5)) (justify left))
    (uuid 12bfdc01-1288-4fac-a632-5cc82297da70)
  )

